APP_NAME="Gestión de Turnos"
APP_ENV=testing
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_FRONTEND_URL=http://localhost:5173

LOG_CHANNEL=stderr

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=testing
DB_USERNAME=postgres
DB_PASSWORD=test
DB_SSLMODE=disable

CACHE_DRIVER=array
SESSION_DRIVER=array
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# Configuración de Seña (simplificada - solo para compatibilidad)
SENIA_PORCENTAJE=30
SENIA_MINUTOS_EXPIRACION=15

# MercadoPago (no usado en testing)
MP_PUBLIC_KEY=TEST-xxxx
MP_ACCESS_TOKEN=TEST-xxxx
MP_WEBHOOK_SECRET=
MP_WEBHOOK_URL=
MP_FRONTEND_URL=http://localhost:5173

# Supabase (no usado en testing)
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_BUCKET=
SUPABASE_REGION=sa-east-1

# Email (no configurado en testing)
MAIL_MAILER=log
MAIL_FROM_ADDRESS=noreply@test.com

# Backup
BACKUP_DISK=local